<?xml version="1.0" encoding="utf-8"?>
<!--
  Capa 1 de defensa contra el hallazgo TICDEFENSE #2 (Bypass SSL Pinning).

  Pinea el SPKI del CA intermediario Google Trust Services WE1 (vigente
  hasta 2029-02-20) como pin primario y el SPKI del root GTS Root R4
  (vigente hasta 2028-01-28) como backup catastrofico.

  Cobertura: dev.mexicox.gob.mx y cursos.aprende.gob.mx comparten la
  misma cadena (Cloudflare Universal SSL via Google Trust Services), asi
  que un solo pin-set sirve a ambos.

  IMPORTANTE: los hosts de archivos (files.*) NO siempre comparten esa
  cadena. files.dev.mexicox.gob.mx se sirve directo por Caddy con cert
  Let's Encrypt (root ISRG), no por Cloudflare. Si se hereda el pin-set de
  GTS via includeSubdomains, el handshake TLS de las imagenes (fotos de
  perfil del bucket privado openedxprofiles, imagenes del foro, etc.)
  falla y Coil no carga nada. Por eso los files.* tienen su propia
  domain-config (mas especifica -> tiene prioridad sobre includeSubdomains)
  con un pin-set que acepta AMBAS cadenas: ISRG (Let's Encrypt, camino
  Caddy directo) y GTS (camino Cloudflare, que prod usa hoy). Asi funciona
  en staging y prod sin romperse si la infra cambia de edge.

  expiration: 2028-12-31. Cuando expire, Android desactiva el pinning
  para evitar brickeo. La capa 2 (OkHttp CertificatePinner) y la capa 3
  (freeRASP) siguen activas como respaldo.

  cleartextTrafficPermitted=false bloquea todo HTTP no cifrado.
-->
<network-security-config>

    <!-- Base config: prohibe HTTP cleartext en toda la app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Pin-set para dominios del backend Open edX (Cursos @prende.mx) -->
    <domain-config>
        <domain includeSubdomains="true">dev.mexicox.gob.mx</domain>
        <domain includeSubdomains="true">cursos.aprende.gob.mx</domain>

        <pin-set expiration="2028-12-31">
            <!-- Pin primario: SPKI de Google Trust Services WE1
                 (CA intermediaria, valida hasta 2029-02-20) -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>

            <!-- Pin backup: SPKI de GTS Root R4
                 (Root CA, valida hasta 2028-01-28) -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
        </pin-set>

        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Pin-set para los hosts de ARCHIVOS (files.*): MinIO/assets servidos
         por Caddy (Let's Encrypt) en staging y por Cloudflare (GTS) en prod.
         Mas especifico que el domain-config de arriba, asi que Android usa
         este para files.* en lugar de heredar los pines de GTS. Acepta ambas
         cadenas para cubrir los dos edges. -->
    <domain-config>
        <domain includeSubdomains="false">files.dev.mexicox.gob.mx</domain>
        <domain includeSubdomains="false">files.cursos.aprende.gob.mx</domain>

        <pin-set expiration="2027-09-30">
            <!-- Let's Encrypt (camino Caddy directo): root ISRG Root X1.
                 Se pinea el ROOT y no la hoja/intermedia porque LE rota los
                 certs cada ~60 dias; el root es estable por anios. -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- Backup Let's Encrypt: root ISRG Root X2 (cadena ECDSA) -->
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>

            <!-- Google Trust Services (camino Cloudflare, prod actual):
                 mismos pines que el host de la API. -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
        </pin-set>

        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

</network-security-config>
